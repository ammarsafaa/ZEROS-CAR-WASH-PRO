{
  "name": "car-wash-pro",
  "productName": "ZEROS CAR WASH PRO",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "description": "ZEROS CAR WASH PRO",
  "author": "ZEROS CAR WASH PRO",
  "build": {
    "appId": "com.zeroscarwashpro.app",
    "productName": "ZEROS CAR WASH PRO",
    "files": [
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "dist/client",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZEROS-CAR-WASH-PRO-Setup-${version}.${ext}",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZEROS CAR WASH PRO",
      "language": "1025",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ammarsafaa",
        "repo": "ZEROS-CAR-WASH-PRO"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "mssql": "11.0.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
